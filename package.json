{
  "name": "nimbus",
  "productName": "Nimbus",
  "version": "0.1.0",
  "description": "A small text editor with a sky behind it. Part of Ozone.",
  "main": "src/main/index.js",
  "type": "commonjs",
  "license": "GPL-3.0-or-later",
  "author": "",
  "keywords": [
    "electron",
    "editor",
    "ozone"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "shortcut": "powershell -ExecutionPolicy Bypass -File tools/make-shortcut.ps1",
    "icon": "powershell -ExecutionPolicy Bypass -File tools/make-icon.ps1",
    "package": "npx --yes @electron/packager . \"Nimbus\" --overwrite --out=dist --asar --icon=assets/icon.ico --prune --ignore=\"^/dist$\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "electron": "^43.4.1"
  }
}
